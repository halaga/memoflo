PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/memoflo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# SEED_ADMIN_PASSWORD=replace-for-local-development

# Comma-separated exact frontend origins for production (e.g. https://app.example.com,https://ringo.memoflo.com)
CORS_ORIGINS=http://localhost:5173
# Optional absolute or API-package-relative persistent file storage directory
MEMOFLO_STORAGE_PATH=storage
